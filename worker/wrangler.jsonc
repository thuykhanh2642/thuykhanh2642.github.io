{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khanh-portfolio-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://thuykhanh2642.github.io",
    "GEMINI_MODEL": "gemini-3.1-flash-lite"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "4102",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
