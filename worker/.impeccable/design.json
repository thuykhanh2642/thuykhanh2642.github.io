      "css": ".ds-label{display:block;font:600 1rem/1.6 \"DM Sans\",sans-serif;color:var(--text,#f3f1e7);margin-bottom:.4rem}.ds-input{font:1rem/1.6 \"DM Sans\",sans-serif;width:100%;min-width:0;min-height:44px;padding:.6rem .8rem;border:1px solid var(--line,#374238);border-radius:8px;background:var(--panel,#18201a);color:var(--text,#f3f1e7)}.ds-input::placeholder{color:var(--muted,#b3b7a8)}.ds-input:focus-visible{outline:2px solid var(--accent,#a8d99c);outline-offset:4px}"
